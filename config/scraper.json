{
  "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
  "requestTimeoutSec": 15,
  "pageDelaySec": 1.0,
  "retry": {
    "maxAttempts": 5,
    "baseDelaySec": 2.0,
    "maxDelaySec": 60.0,
    "retryStatus": [429, 500, 502, 503, 504]
  },
  "rendering": {"mode": "static", "waitSelector": "", "timeoutMs": 30000},
  "staleJobDeletion": false,
  "manageCompany": true,
  "defaultLocation": ["Bucuresti"],
  "defaultWorkmode": "on-site",
  "ownJobUrlPrefix": "https://lcdn.bricostore.ro/render/cariere",
  "sources": {
    "sitemap": "",
    "listing": "https://lcdn.bricostore.ro/render/cariere/",
    "jobArchive": "https://lcdn.bricostore.ro/render/cariere/#"
  },
  "selectors": {
    "jobArticle": ["div.border.rounded.px-8", "[class*='job']", ".vacancy, .position, .listing-item"],
    "jobTitle": ["h2", "h1, h2, h3, h4", "[itemprop='title'], [aria-label]", "a"],
    "jobMeta": ["div.w-full", "p, .meta, [class*='deadline']"]
  }
}